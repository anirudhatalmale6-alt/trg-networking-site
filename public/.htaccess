# ---------------------------------------------------------------------------
# TRG Networking
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# --- Legacy URLs from the Lovable build ------------------------------------
# Anything already shared or indexed under the old slugs lands on the merged
# page instead of a 404. 301 = permanent, so search engines pass the value on.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^managed-it-services/?$        /managed-it [R=301,L]
    RewriteRule ^help-desk-it-support/?$       /help-desk [R=301,L]
    RewriteRule ^microsoft-365-cloud/?$        /microsoft-cloud [R=301,L]
    RewriteRule ^secure-ai-adoption/?$         /ai-services [R=301,L]
    RewriteRule ^cmmc-readiness/?$             /cmmc [R=301,L]
    RewriteRule ^backup-business-continuity/?$ /business-continuity [R=301,L]
    RewriteRule ^construction/?$               /industries/construction [R=301,L]
    RewriteRule ^manufacturing/?$              /industries/manufacturing [R=301,L]
    RewriteRule ^government-contractors/?$     /industries/government-contractors [R=301,L]
    RewriteRule ^professional-services/?$      /industries/professional-services [R=301,L]

    # --- Single-page-app fallback ------------------------------------------
    # Every route is pre-rendered to a real HTML file at build time, so a
    # direct hit serves that file. Anything else falls through to index.html
    # and React Router decides (including the 404 page).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # Hashed filenames, safe to cache hard.
    <FilesMatch "\.(js|css|woff2)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
        ExpiresDefault "access plus 6 months"
    </FilesMatch>
    # HTML must revalidate, otherwise a content edit stays invisible.
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json image/svg+xml
</IfModule>

# --- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

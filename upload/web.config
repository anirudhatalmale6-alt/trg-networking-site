<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration — for Azure App Service on Windows.

  Azure does not read .htaccess. This is the IIS equivalent of that file, and
  staticwebapp.config.json is the equivalent for Azure Static Web Apps. Use
  whichever matches the service you deploy to; keep the redirect maps in sync.

  Requires the URL Rewrite module, which Azure App Service has by default.
-->
<configuration>
  <system.webServer>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- Interim slugs from the Hostinger staging build -->
        <rule name="s-managed-it" stopProcessing="true">
          <match url="^managed-it/?$" /><action type="Redirect" url="/managed-it-services" redirectType="Permanent" />
        </rule>
        <rule name="s-help-desk" stopProcessing="true">
          <match url="^help-desk/?$" /><action type="Redirect" url="/help-desk-it-support" redirectType="Permanent" />
        </rule>
        <rule name="s-ms-cloud" stopProcessing="true">
          <match url="^microsoft-cloud/?$" /><action type="Redirect" url="/microsoft-365-cloud" redirectType="Permanent" />
        </rule>
        <rule name="s-ai" stopProcessing="true">
          <match url="^ai-services/?$" /><action type="Redirect" url="/secure-ai-adoption" redirectType="Permanent" />
        </rule>
        <rule name="s-cmmc" stopProcessing="true">
          <match url="^cmmc/?$" /><action type="Redirect" url="/cmmc-readiness" redirectType="Permanent" />
        </rule>
        <rule name="s-bc" stopProcessing="true">
          <match url="^business-continuity/?$" /><action type="Redirect" url="/backup-business-continuity" redirectType="Permanent" />
        </rule>
        <rule name="s-ind" stopProcessing="true">
          <match url="^industries/(construction|manufacturing|government-contractors|professional-services)/?$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Old WordPress site at www.trgnetworking.com.
             /managed-it-services/ needs no rule: same path on both sites. -->
        <rule name="w-netsec" stopProcessing="true">
          <match url="^network-security/?$" /><action type="Redirect" url="/cybersecurity" redirectType="Permanent" />
        </rule>
        <rule name="w-cloud" stopProcessing="true">
          <match url="^cloud-computing/?$" /><action type="Redirect" url="/microsoft-365-cloud" redirectType="Permanent" />
        </rule>
        <rule name="w-backup" stopProcessing="true">
          <match url="^data-backup-and-recovery/?$" /><action type="Redirect" url="/backup-business-continuity" redirectType="Permanent" />
        </rule>
        <rule name="w-contact" stopProcessing="true">
          <match url="^about-us/contact-us/?$" /><action type="Redirect" url="/contact" redirectType="Permanent" />
        </rule>
        <rule name="w-referral" stopProcessing="true">
          <match url="^about-us/referral-program/?$" /><action type="Redirect" url="/about" redirectType="Permanent" />
        </rule>
        <rule name="w-about" stopProcessing="true">
          <match url="^about-us/?$" /><action type="Redirect" url="/about" redirectType="Permanent" />
        </rule>
        <rule name="w-why" stopProcessing="true">
          <match url="^why-choose-us/?$" /><action type="Redirect" url="/why-trg" redirectType="Permanent" />
        </rule>
        <rule name="w-clients" stopProcessing="true">
          <match url="^our-clients/?$" /><action type="Redirect" url="/resources/case-studies" redirectType="Permanent" />
        </rule>
        <rule name="w-testimonial" stopProcessing="true">
          <match url="^testimonial/[^/]+/?$" /><action type="Redirect" url="/resources/case-studies" redirectType="Permanent" />
        </rule>
        <rule name="w-assessment" stopProcessing="true">
          <match url="^free-network-assessment/?$" /><action type="Redirect" url="/contact?type=assessment" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="w-consult" stopProcessing="true">
          <match url="^(initial-consultation|discoverycall)/?$" /><action type="Redirect" url="/contact" redirectType="Permanent" />
        </rule>
        <rule name="w-tips" stopProcessing="true">
          <match url="^cyber-security-tip-of-the-week/?$" /><action type="Redirect" url="/resources" redirectType="Permanent" />
        </rule>
        <rule name="w-buyersguide" stopProcessing="true">
          <match url="^itbuyersguide/?$" /><action type="Redirect" url="/resources/guides" redirectType="Permanent" />
        </rule>
        <rule name="w-crisis" stopProcessing="true">
          <match url="^new-cybersecurity-crisis/?$" /><action type="Redirect" url="/cybersecurity" redirectType="Permanent" />
        </rule>
        <rule name="w-landing" stopProcessing="true">
          <match url="^(3problems|aspirin|thank-you-aspirin|closerlook|is-this-you)/?$" />
          <action type="Redirect" url="/resources" redirectType="Permanent" />
        </rule>
        <rule name="w-blog" stopProcessing="true">
          <match url="^[0-9]{4}/[0-9]{2}/[0-9]{2}/.+" />
          <action type="Redirect" url="/resources" redirectType="Permanent" />
        </rule>

        <!-- SPA fallback. Every route is pre-rendered to a real file, so a
             direct hit serves that file; anything else falls to index.html. -->
        <rule name="spa-fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DontCache" />
        <add extension=".js"   policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" duration="365.00:00:00" />
        <add extension=".css"  policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" duration="365.00:00:00" />
        <add extension=".webp" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" duration="180.00:00:00" />
      </profiles>
    </caching>

  </system.webServer>
</configuration>

# ---------------------------------------------------------------------------
# TRG Networking
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# The site uses the LOVABLE URL structure. Service and industry pages sit at
# the root: /managed-it-services, /construction, and so on.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Interim slugs from the Hostinger staging build ---------------------
    # These were never public, but they were shared during the build, so they
    # land on the real page rather than a 404.
    RewriteRule ^managed-it/?$                        /managed-it-services [R=301,L]
    RewriteRule ^help-desk/?$                         /help-desk-it-support [R=301,L]
    RewriteRule ^microsoft-cloud/?$                   /microsoft-365-cloud [R=301,L]
    RewriteRule ^ai-services/?$                       /secure-ai-adoption [R=301,L]
    RewriteRule ^cmmc/?$                              /cmmc-readiness [R=301,L]
    RewriteRule ^business-continuity/?$               /backup-business-continuity [R=301,L]
    RewriteRule ^industries/construction/?$           /construction [R=301,L]
    RewriteRule ^industries/manufacturing/?$          /manufacturing [R=301,L]
    RewriteRule ^industries/government-contractors/?$ /government-contractors [R=301,L]
    RewriteRule ^industries/professional-services/?$  /professional-services [R=301,L]

    # --- Old WordPress site at www.trgnetworking.com ------------------------
    # Only relevant once this build replaces the live WordPress site. Every
    # URL in that site's sitemap is mapped here so nothing 404s on cutover and
    # the ranking on each page transfers to its replacement.
    # /managed-it-services/ needs no rule — the old WordPress site and this one
    # use the same path, so its ranking carries over directly.
    RewriteRule ^network-security/?$      /cybersecurity [R=301,L]
    RewriteRule ^cloud-computing/?$       /microsoft-365-cloud [R=301,L]
    RewriteRule ^data-backup-and-recovery/?$ /backup-business-continuity [R=301,L]
    RewriteRule ^about-us/contact-us/?$   /contact [R=301,L]
    RewriteRule ^about-us/referral-program/?$ /about [R=301,L]
    RewriteRule ^about-us/?$              /about [R=301,L]
    RewriteRule ^why-choose-us/?$         /why-trg [R=301,L]
    RewriteRule ^our-clients/?$           /resources/case-studies [R=301,L]
    RewriteRule ^testimonial/[^/]+/?$     /resources/case-studies [R=301,L]
    RewriteRule ^free-network-assessment/?$ /contact?type=assessment [R=301,L]
    RewriteRule ^initial-consultation/?$  /contact [R=301,L]
    RewriteRule ^discoverycall/?$         /contact [R=301,L]
    RewriteRule ^cyber-security-tip-of-the-week/?$ /resources [R=301,L]
    RewriteRule ^itbuyersguide/?$         /resources/guides [R=301,L]
    RewriteRule ^new-cybersecurity-crisis/?$ /cybersecurity [R=301,L]
    RewriteRule ^(3problems|aspirin|thank-you-aspirin|closerlook|is-this-you)/?$ /resources [R=301,L]

    # The 36 blog posts under /YYYY/MM/DD/. Until the blog itself is migrated,
    # these land on Resources rather than 404. Replace with per-post targets
    # once a decision is made about the old blog — see HANDOFF.md.
    RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/.+ /resources [R=301,L]

    # NOT redirected on purpose: /support-center/ is a live client portal that
    # must keep working. Leave it on the current host or exclude it from the
    # cutover.

    # --- Single-page-app fallback ------------------------------------------
    # Every route is pre-rendered to a real HTML file at build time, so a
    # direct hit serves that file. Anything else falls through to index.html
    # and React Router decides (including the 404 page).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # Hashed filenames, safe to cache hard.
    <FilesMatch "\.(js|css|woff2)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
        ExpiresDefault "access plus 6 months"
    </FilesMatch>
    # HTML must revalidate, otherwise a content edit stays invisible.
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json image/svg+xml
</IfModule>

# --- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

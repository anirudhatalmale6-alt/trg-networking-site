<?xml version="1.0" encoding="UTF-8"?>
<!--
  TRG Networking - IIS configuration for WordPress.
  This file does on IIS what .htaccess does on Apache. The package ships an
  .htaccess as well; IIS ignores it, so this is the one that matters here.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- IIS will not serve a file type it does not know. The theme images are
           WebP and the fonts are WOFF2, so both are declared explicitly. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Every response was announcing "PHP/8.3.2" and "ASP.NET" to anyone
             who looked. That tells an attacker which exploits are worth trying
             before they try anything, and it is the first thing TRG would tell
             a client to turn off. ASP.NET's header is removed here; PHP's is
             stripped by the outbound rule below, because expose_php can only
             be set in the server's own php.ini. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!--
          Six months. Added 12 September, the morning the certificate became
          trusted - not before, because HSTS tells a browser to refuse plain
          http for this domain and that would have been unrecoverable while the
          certificate was broken. includeSubDomains is deliberately off until
          test.trgnetworking.com has a certificate of its own.
        -->
        <add name="Strict-Transport-Security" value="max-age=15768000" />
      </customHeaders>
    </httpProtocol>

    <rewrite>

      <outboundRules>
        <!-- PHP adds its own X-Powered-By after IIS has finished with the
             response, so the customHeaders <remove> above cannot reach it. -->
        <rule name="Strip X-Powered-By">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>

      <rules>

        <!--
          Canonical host first, then scheme. Ordered this way so a request for
          http://trgnetworking.com/page makes ONE hop to
          https://www.trgnetworking.com/page rather than two.
        -->
        <rule name="Canonical host - add www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^trgnetworking\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.trgnetworking.com/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Redirect to HTTPS" patternSyntax="Wildcard" stopProcessing="true">
          <match url="*" />
          <conditions>
            <add input="{HTTPS}" pattern="OFF" />
            <!--
              The test hostname is excluded. The certificate covers
              trgnetworking.com and www.trgnetworking.com only, so forcing the
              test address to https sends it to a name-mismatch error - which
              is exactly what happened the first time this rule went back on.
              Remove this line when the test address is retired, or add
              test.trgnetworking.com to the certificate.
            -->
            <add input="{HTTP_HOST}" pattern="test.trgnetworking.com" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" />
        </rule>


        <!-- Files that must never be downloadable. -->
        <rule name="Block sensitive files" stopProcessing="true">
          <match url="^(wp-config\.php|\.htaccess|\.user\.ini|readme\.html|license\.txt|.*\.log|.*\.sql|.*\.tsv)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- xmlrpc.php is the single most brute-forced endpoint in WordPress and
             nothing on this site uses it. -->
        <rule name="Block xmlrpc" stopProcessing="true">
          <match url="^xmlrpc\.php$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- Standard WordPress pretty permalinks. Anything that is not a real
             file or folder is handed to index.php, which works out the page. -->
        <rule name="WordPress" patternSyntax="Wildcard">
          <match url="*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>

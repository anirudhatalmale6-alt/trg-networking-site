<?xml version="1.0" encoding="UTF-8"?>
<!--
  TRG Networking - IIS configuration for WordPress.
  This file does on IIS what .htaccess does on Apache. The package ships an
  .htaccess as well; IIS ignores it, so this is the one that matters here.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- IIS will not serve a file type it does not know. The theme images are
           WebP and the fonts are WOFF2, so both are declared explicitly. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Every response was announcing "PHP/8.3.2" and "ASP.NET" to anyone
             who looked. That tells an attacker which exploits are worth trying
             before they try anything, and it is the first thing TRG would tell
             a client to turn off. ASP.NET's header is removed here; PHP's is
             stripped by the outbound rule below, because expose_php can only
             be set in the server's own php.ini. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <rewrite>

      <outboundRules>
        <!-- PHP adds its own X-Powered-By after IIS has finished with the
             response, so the customHeaders <remove> above cannot reach it. -->
        <rule name="Strip X-Powered-By">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>

      <rules>

        <!--
          A "Redirect to HTTPS" rule was added here on 11 September. It has been
          commented out, not deleted, because it cannot work yet: the
          certificate on this server is not one browsers trust, so sending
          every visitor to https sends them to a security warning instead of
          the site. With it off, the site is reachable over http.

          Put it back the moment a trusted certificate is installed - just
          remove these comment markers. It belongs in the finished site.

          <rule name="Redirect to HTTPS" patternSyntax="Wildcard" stopProcessing="true">
            <match url="*" />
            <conditions>
              <add input="{HTTPS}" pattern="OFF" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" />
          </rule>
        -->


        <!-- Files that must never be downloadable. -->
        <rule name="Block sensitive files" stopProcessing="true">
          <match url="^(wp-config\.php|\.htaccess|\.user\.ini|readme\.html|license\.txt|.*\.log|.*\.sql|.*\.tsv)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- xmlrpc.php is the single most brute-forced endpoint in WordPress and
             nothing on this site uses it. -->
        <rule name="Block xmlrpc" stopProcessing="true">
          <match url="^xmlrpc\.php$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- Standard WordPress pretty permalinks. Anything that is not a real
             file or folder is handed to index.php, which works out the page. -->
        <rule name="WordPress" patternSyntax="Wildcard">
          <match url="*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
